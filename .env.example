# Alarrab CodeVision AI — environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# development | production
ENV=production
DEBUG=false

# REQUIRED in production: unique random value, 32+ chars.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_random_48_char_secret

# Authentication
AUTH_REQUIRED=true
JWT_EXPIRES_MINUTES=60
# Optional static API keys: comma-separated key:tenant_id:role entries
# API_KEYS=examplekey123:pilot-office:engineer
API_KEYS=

# Database (PostgreSQL in production; SQLite fallback for local demo)
POSTGRES_USER=alarrab
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=alarrab
DATABASE_URL=postgresql+psycopg2://alarrab:CHANGE_ME_strong_db_password@db:5432/alarrab

# HTTP hardening
CORS_ORIGINS=https://your-domain.example
RATE_LIMIT_PER_MINUTE=120
ENABLE_HSTS=true

# Uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.ifc,.dxf,.json
STORAGE_DIR=/data/storage

# Seeding (optional; demo data is refused in production unless explicitly enabled)
SEED_DEMO_DATA=false
# SEED_ADMIN_PASSWORD=set_only_when_seeding
